// AIPanel - Prisma Schema
// Database schema for multi-tenant AI agent management system

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  SUPPORT
}

enum TenantRole {
  OWNER
  ADMIN
  DEVELOPER
  VIEWER
}

enum ServerStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  BLOCKED
}

enum PaymentStatus {
  PAID
  PENDING
  OVERDUE
  CANCELLED
}

enum AIModel {
  // OpenAI GPT-5 Series
  GPT5
  GPT5_MINI
  GPT5_NANO

  // OpenAI O-Series (Reasoning)
  O1
  O1_MINI
  O3
  O3_MINI
  O3_PRO
  O4_MINI

  // OpenAI Realtime
  GPT_REALTIME_MINI

  // Claude Series
  CLAUDE_SONNET_4_5
  CLAUDE_SONNET_4
  CLAUDE_OPUS_4
  CLAUDE_HAIKU_4

  // Legacy
  GPT4O
  GPT4_TURBO
}

enum AgentStatus {
  ACTIVE
  PAUSED
  ERROR
}

enum DataSourceType {
  PDF
  WEBPAGE
  DOCUMENT
  API
  IMAGE
  VIDEO
}

enum DataSourceStatus {
  PENDING
  PROCESSING
  READY
  ERROR
}

enum TransactionType {
  CHARGE
  PAYMENT
  REFUND
  CREDIT
}

enum BillingPlan {
  FREE
  STARTER
  PROFESSIONAL
  BUSINESS
  ENTERPRISE
}

enum PaymentMethodType {
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  CRYPTO
}

// ============================================
// MODELS
// ============================================

// Usuario administrador del sistema (Nivel 1)
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String    // bcrypt hashed
  name          String
  role          AdminRole @default(ADMIN)
  isActive      Boolean   @default(true)

  // Auditoría
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  // Refresh tokens
  refreshTokens RefreshToken[]

  @@map("users")
}

// Usuario de Tenant (Nivel 2)
model TenantUser {
  id            String      @id @default(cuid())
  tenantId      String
  email         String      @unique
  password      String      // bcrypt hashed
  name          String
  role          TenantRole  @default(VIEWER)
  isActive      Boolean     @default(true)

  // Relaciones
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Auditoría
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  lastLoginAt   DateTime?

  // Refresh tokens
  refreshTokens RefreshToken[]

  @@index([tenantId])
  @@map("tenant_users")
}

// Refresh Tokens (para ambos niveles)
model RefreshToken {
  id            String      @id @default(cuid())
  token         String      @unique

  // Usuario puede ser Admin o TenantUser
  userId        String?
  tenantUserId  String?

  user          User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantUser    TenantUser? @relation(fields: [tenantUserId], references: [id], onDelete: Cascade)

  expiresAt     DateTime
  createdAt     DateTime    @default(now())

  @@index([token])
  @@map("refresh_tokens")
}

// Logs de auditoría
model AuditLog {
  id            String   @id @default(cuid())

  // Quién hizo la acción
  userId        String?
  tenantUserId  String?
  userType      String   // 'admin' | 'tenant'
  userEmail     String

  // Qué hizo
  action        String   // 'CREATE', 'UPDATE', 'DELETE', 'LOGIN', etc.
  resource      String   // 'server', 'tenant', 'agent', etc.
  resourceId    String?

  // Detalles
  changes       Json?    // Cambios realizados
  metadata      Json?    // Información adicional

  // IP y User Agent
  ipAddress     String?
  userAgent     String?

  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([tenantUserId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// Nivel 1: Servidor con APIKEY principal
model Server {
  id            String       @id @default(cuid())
  name          String
  description   String?
  apiKey        String       @unique
  status        ServerStatus @default(ACTIVE)

  // Configuración
  maxTenants    Int          @default(10)

  // Relaciones
  tenants       Tenant[]

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("servers")
}

// Nivel 2: Tenant (Cliente) dentro del servidor
model Tenant {
  id                String        @id @default(cuid())
  serverId          String

  // Información básica
  name              String
  email             String        @unique
  companyName       String?

  // APIKEY única del tenant
  apiKey            String        @unique

  // Estado
  status            TenantStatus  @default(TRIAL)
  paymentStatus     PaymentStatus @default(PENDING)

  // Facturación
  billingPlan       BillingPlan   @default(FREE)
  balance           Decimal       @default(0) @db.Decimal(10, 2)
  creditBalance     Decimal       @default(0) @db.Decimal(10, 2)
  billingCycle      String        @default("monthly") // monthly, yearly
  nextBillingDate   DateTime?

  // Límites
  monthlyTokenLimit Int           @default(1000)
  currentMonthUsage Int           @default(0)

  // Configuración de suspensión
  autoSuspendOnOverage      Boolean @default(true)
  autoSuspendOnNonPayment   Boolean @default(true)
  gracePeriodDays           Int     @default(14)

  // Relaciones
  server            Server               @relation(fields: [serverId], references: [id], onDelete: Cascade)
  users             TenantUser[]         // Usuarios del tenant
  agents            Agent[]
  dataSources       DataSource[]
  payments          Payment[]
  transactions      Transaction[]
  usageMetrics      UsageMetric[]

  // Sistema de tracking de tokens
  tokenUsage        TokenUsage[]
  usageSummary      TenantUsageSummary[]
  usageThresholds   UsageThreshold[]
  usageAlerts       UsageAlert[]

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@map("tenants")
}

// Agente AI personalizado
model Agent {
  id                String       @id @default(cuid())
  tenantId          String

  // Información básica
  name              String
  description       String?

  // Configuración del modelo
  model             AIModel      @default(GPT5_MINI)

  // Parámetros del modelo
  systemPrompt      String       @db.Text

  // Parámetros GPT-5
  reasoningLevel    String?      // minimal, low, medium, high

  // Parámetros O-Series
  reasoningEffort   String?      // low, medium, high
  verbosity         String?      // low, medium, high

  // Parámetros tradicionales (solo modelos no-reasoning)
  temperature       Float?
  maxTokens         Int?

  // Parámetros reasoning models
  maxCompletionTokens Int?

  // Context window
  contextWindow     Int          @default(128000)

  // Características avanzadas
  memoryEnabled     Boolean      @default(true)
  autoLearn         Boolean      @default(false)

  // Estado
  status            AgentStatus  @default(ACTIVE)

  // Métricas
  totalInteractions Int          @default(0)
  averageTokensUsed Int          @default(0)
  totalCost         Decimal      @default(0) @db.Decimal(10, 4)

  // Relaciones
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dataSources       DataSource[]
  conversations     Conversation[]
  usageMetrics      UsageMetric[]
  tokenUsage        TokenUsage[]

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@map("agents")
}

// Fuentes de datos para agentes (DEPRECATED - usar Document)
model DataSource {
  id            String           @id @default(cuid())
  tenantId      String
  agentId       String?

  // Información
  type          DataSourceType
  name          String
  description   String?

  // Ubicación
  url           String?
  fileUrl       String?
  s3Key         String?

  // Metadata
  fileSize      Int?
  mimeType      String?

  // Procesamiento
  status        DataSourceStatus @default(PENDING)
  processedAt   DateTime?
  errorMessage  String?

  // Embeddings/Vector store (DEPRECATED - usar resúmenes)
  vectorStoreId String?

  // Relaciones
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent         Agent?           @relation(fields: [agentId], references: [id], onDelete: Cascade)

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@map("data_sources")
}

// ============================================
// SISTEMA DE RESÚMENES AUTOMÁTICOS
// (Reemplazo simple y eficiente de vector stores)
// ============================================

// Documento original subido por el usuario
model Document {
  id              String   @id @default(cuid())
  tenantId        String
  agentId         String?

  // Información básica
  name            String
  type            String   // 'pdf', 'url', 'docx', 'txt', 'image'

  // Ubicación original
  originalUrl     String?
  s3Key           String?

  // Contenido extraído (texto plano)
  content         String   @db.Text
  contentHash     String   @unique  // SHA256 para detectar duplicados

  // Metadatos
  size            Int      // Tamaño en bytes
  mimeType        String?
  metadata        Json?    // { author, date, pages, etc }

  // Procesamiento
  status          DataSourceStatus @default(PENDING)
  processedAt     DateTime?
  errorMessage    String?

  // Relaciones
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chunks          DocumentChunk[]
  summaries       DocumentSummary[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("documents")
  @@index([tenantId, agentId])
  @@index([contentHash])
  @@index([status])
}

// Chunks del documento (división inteligente)
model DocumentChunk {
  id              String   @id @default(cuid())
  documentId      String
  chunkIndex      Int      // Orden del chunk (0, 1, 2...)

  // Contenido del chunk
  content         String   @db.Text
  wordCount       Int

  // Para búsqueda de texto completo (PostgreSQL)
  // searchVector se crea con: to_tsvector('spanish', content)

  // Relaciones
  document        Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  summary         ChunkSummary?

  createdAt       DateTime @default(now())

  @@map("document_chunks")
  @@index([documentId, chunkIndex])
  @@unique([documentId, chunkIndex])
}

// Resumen del chunk (generado por GPT)
model ChunkSummary {
  id              String   @id @default(cuid())
  chunkId         String   @unique

  // Resumen generado
  summary         String   @db.Text

  // Keywords y tópicos extraídos
  keywords        String[] // ["keyword1", "keyword2", ...]
  topics          String[] // ["topic1", "topic2", ...]

  // Metadatos de generación
  model           String   // "gpt-4o-mini", etc
  tokensUsed      Int

  // Relaciones
  chunk           DocumentChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())

  @@map("chunk_summaries")
  @@index([keywords])
  @@index([topics])
}

// Resumen de documento completo (rollup de chunks)
model DocumentSummary {
  id              String   @id @default(cuid())
  documentId      String
  level           Int      @default(1)  // Nivel de abstracción (1=ejecutivo, 2=detallado)

  // Resumen del documento completo
  summary         String   @db.Text
  keyPoints       String[] // Puntos clave del documento
  keywords        String[] // Keywords principales
  topics          String[] // Tópicos principales

  // Metadatos de generación
  model           String
  tokensUsed      Int

  // Relaciones
  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())

  @@map("document_summaries")
  @@index([documentId, level])
  @@index([keywords])
  @@index([topics])
}

// Conversaciones de agentes (para memoria)
model Conversation {
  id            String   @id @default(cuid())
  agentId       String

  // Session info
  sessionId     String

  // Metadata
  title         String?

  // Relaciones
  agent         Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  messages      Message[]
  tokenUsage    TokenUsage[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([agentId, sessionId])
  @@map("conversations")
}

// Mensajes de conversación
model Message {
  id              String       @id @default(cuid())
  conversationId  String

  // Contenido
  role            String       // user, assistant, system
  content         String       @db.Text

  // Tokens
  inputTokens     Int?
  outputTokens    Int?
  reasoningTokens Int?

  // Relaciones
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt       DateTime     @default(now())

  @@index([conversationId])
  @@map("messages")
}

// Sistema de pagos
model Payment {
  id                String            @id @default(cuid())
  tenantId          String

  // Información del pago
  amount            Decimal           @db.Decimal(10, 2)
  currency          String            @default("USD")
  status            String            // pending, completed, failed, refunded

  // Método de pago
  paymentMethod     PaymentMethodType @default(CREDIT_CARD)

  // Integración con Stripe
  stripePaymentId   String?           @unique
  stripeCustomerId  String?

  // Metadata
  description       String?
  metadata          Json?

  // Relaciones
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@map("payments")
}

// Cartola/Ledger de transacciones
model Transaction {
  id            String          @id @default(cuid())
  tenantId      String

  // Tipo y monto
  type          TransactionType
  amount        Decimal         @db.Decimal(10, 2)

  // Descripción
  description   String

  // Balance después de la transacción
  balanceAfter  Decimal         @db.Decimal(10, 2)

  // Metadata
  metadata      Json?

  // Relaciones
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt     DateTime        @default(now())

  @@index([tenantId, createdAt])
  @@map("transactions")
}

// Métricas de uso de AI
model UsageMetric {
  id              String   @id @default(cuid())
  tenantId        String
  agentId         String?

  // Uso general
  apiCalls        Int      @default(0)

  // Desglose de tokens
  inputTokens     Int      @default(0)
  outputTokens    Int      @default(0)
  reasoningTokens Int      @default(0)
  totalTokens     Int      @default(0)

  // Costos desglosados
  inputCost       Decimal  @default(0) @db.Decimal(10, 4)
  outputCost      Decimal  @default(0) @db.Decimal(10, 4)
  reasoningCost   Decimal  @default(0) @db.Decimal(10, 4)
  totalCost       Decimal  @default(0) @db.Decimal(10, 4)

  // Metadata
  model           AIModel
  date            DateTime @default(now())

  // Errores
  errors          Int      @default(0)

  // Relaciones
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent           Agent?   @relation(fields: [agentId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())

  @@index([tenantId, date])
  @@index([agentId, date])
  @@map("usage_metrics")
}

// Alertas y notificaciones
model Alert {
  id          String   @id @default(cuid())

  // Tipo de alerta
  type        String   // payment_overdue, quota_exceeded, low_balance, etc.
  severity    String   // info, warning, critical

  // Mensaje
  title       String
  message     String   @db.Text

  // Target
  targetType  String   // tenant, server, agent
  targetId    String

  // Estado
  isRead      Boolean  @default(false)
  isResolved  Boolean  @default(false)

  // Metadata
  metadata    Json?

  createdAt   DateTime @default(now())
  resolvedAt  DateTime?

  @@index([targetType, targetId, isResolved])
  @@map("alerts")
}

// Webhooks de Stripe
model StripeWebhook {
  id            String   @id @default(cuid())

  // Stripe event
  eventId       String   @unique
  eventType     String

  // Payload
  payload       Json

  // Procesamiento
  processed     Boolean  @default(false)
  processedAt   DateTime?
  error         String?

  createdAt     DateTime @default(now())

  @@map("stripe_webhooks")
}

// ============================================
// SISTEMA DE TRACKING DE TOKENS
// ============================================

// Registro detallado de uso de tokens por request
model TokenUsage {
  id              String   @id @default(cuid())

  // Identificadores
  tenantId        String
  agentId         String?
  conversationId  String?

  // Request info
  requestId       String   @unique
  endpoint        String   // '/api/agents/chat', '/api/agents/complete'
  model           AIModel

  // Tokens desglosados
  inputTokens     Int      @default(0)
  outputTokens    Int      @default(0)
  reasoningTokens Int      @default(0)  // Solo para O-series
  cachedTokens    Int      @default(0)  // Tokens en caché
  totalTokens     Int      @default(0)

  // Costos desglosados (en USD)
  inputCost       Decimal  @db.Decimal(10, 6)
  outputCost      Decimal  @db.Decimal(10, 6)
  reasoningCost   Decimal  @db.Decimal(10, 6)
  cacheCost       Decimal  @db.Decimal(10, 6)
  totalCost       Decimal  @db.Decimal(10, 6)

  // Metadata de la request
  latencyMs       Int?     // Tiempo de respuesta en ms
  success         Boolean  @default(true)
  errorCode       String?
  errorMessage    String?

  // Timestamp
  timestamp       DateTime @default(now())

  // Relaciones
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent           Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)
  conversation    Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([tenantId, timestamp])
  @@index([agentId, timestamp])
  @@index([requestId])
  @@index([timestamp])
  @@map("token_usage")
}

// Resumen agregado de uso por día
model TenantUsageSummary {
  id                  String   @id @default(cuid())
  tenantId            String
  date                DateTime // Día específico (fecha sin hora)

  // Agregados del día
  totalRequests       Int      @default(0)
  successfulRequests  Int      @default(0)
  failedRequests      Int      @default(0)

  // Tokens totales del día
  totalInputTokens    Int      @default(0)
  totalOutputTokens   Int      @default(0)
  totalReasoningTokens Int     @default(0)
  totalCachedTokens   Int      @default(0)
  totalTokens         Int      @default(0)

  // Costos totales del día
  totalCost           Decimal  @db.Decimal(10, 2)

  // Por modelo (JSON)
  modelBreakdown      Json     // { "gpt-5-mini": { tokens: 1000, cost: 0.5 }, ... }

  // Relaciones
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([tenantId, date])
  @@index([tenantId, date])
  @@map("tenant_usage_summary")
}

// Umbrales de uso configurables por tenant
model UsageThreshold {
  id                  String   @id @default(cuid())
  tenantId            String

  // Tipo de límite
  type                String   // 'daily', 'monthly', 'per_request'
  name                String?  // Nombre descriptivo

  // Límites
  maxTokens           Int?     // Máximo de tokens
  maxCost             Decimal? @db.Decimal(10, 2) // Máximo costo en USD
  maxRequests         Int?     // Máximo número de requests

  // Umbrales de alerta (porcentajes)
  warningAt           Int      @default(75)  // % para warning
  criticalAt          Int      @default(90)  // % para critical

  // Acciones automáticas
  throttleAt          Int?     // % para empezar throttling
  suspendAt           Int?     // % para suspender

  // Configuración de throttling
  throttleDelay       Int?     // ms de delay por request
  throttleMaxRequests Int?     // requests máximas por minuto cuando throttled

  // Notificaciones
  notifyEmail         Boolean  @default(true)
  notifyDashboard     Boolean  @default(true)
  notifyWebhook       Boolean  @default(false)
  webhookUrl          String?

  // Estado
  isActive            Boolean  @default(true)

  // Relaciones
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  alerts              UsageAlert[]

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([tenantId, isActive])
  @@map("usage_thresholds")
}

// Alertas específicas de uso de tokens
model UsageAlert {
  id              String   @id @default(cuid())
  tenantId        String
  thresholdId     String?

  // Tipo de alerta
  level           String   // 'info', 'warning', 'critical'
  type            String   // 'threshold_exceeded', 'daily_limit', 'monthly_limit', 'cost_limit'

  // Mensaje
  title           String
  message         String   @db.Text

  // Datos del uso
  currentUsage    Int      // Tokens usados o costo
  limit           Int      // Límite configurado
  percentage      Int      // % del límite alcanzado

  // Metadata adicional
  metadata        Json?

  // Estado
  isRead          Boolean  @default(false)
  isResolved      Boolean  @default(false)
  resolvedAt      DateTime?
  resolvedBy      String?  // userId que resolvió

  // Acciones tomadas automáticamente
  actionTaken     String?  // 'email_sent', 'throttled', 'suspended', 'webhook_called'

  // Relaciones
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  threshold       UsageThreshold? @relation(fields: [thresholdId], references: [id], onDelete: SetNull)

  createdAt       DateTime @default(now())

  @@index([tenantId, isResolved, createdAt])
  @@index([level, isResolved])
  @@index([createdAt])
  @@map("usage_alerts")
}
