# ==================================
# CONFIGURACIÓN DE PUERTOS
# ==================================
# Cambia estos puertos si ya tienes otros servicios corriendo
BACKEND_PORT=4000
FRONTEND_PORT=3000
POSTGRES_PORT=5433
REDIS_PORT=6380

# ==================================
# MODO DE EJECUCIÓN
# ==================================
NODE_ENV=production

# ==================================
# BASE DE DATOS
# ==================================
POSTGRES_DB=aipanel
POSTGRES_USER=aipanel
POSTGRES_PASSWORD=change_this_password_in_production
DATABASE_URL=postgresql://aipanel:change_this_password_in_production@localhost:5433/aipanel

# ==================================
# REDIS
# ==================================
REDIS_PASSWORD=change_this_redis_password
REDIS_URL=redis://:change_this_redis_password@localhost:6380

# ==================================
# JWT SECRETS
# ==================================
# Genera con: openssl rand -base64 32
JWT_SECRET=change_this_jwt_secret_key
JWT_REFRESH_SECRET=change_this_refresh_secret_key
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ==================================
# URLS
# ==================================
# URL pública del frontend (para CORS y emails)
FRONTEND_URL=https://aipanel.tudominio.com

# URL pública del backend API
NEXT_PUBLIC_API_URL=https://api.aipanel.tudominio.com

# ==================================
# OPENAI API
# ==================================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ORG_ID=your_org_id_here

# ==================================
# ANTHROPIC (CLAUDE) API
# ==================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ==================================
# STRIPE (PAGOS)
# ==================================
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# ==================================
# AWS S3 (ALMACENAMIENTO)
# ==================================
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-east-1
AWS_S3_BUCKET=aipanel-storage

# ==================================
# EMAIL (SENDGRID/RESEND)
# ==================================
SENDGRID_API_KEY=your_sendgrid_api_key_here
EMAIL_FROM=noreply@tudominio.com
EMAIL_FROM_NAME=AIPanel

# ==================================
# CONFIGURACIÓN DE SEGURIDAD
# ==================================
# Lista de dominios permitidos para CORS (separados por coma)
CORS_ORIGINS=https://aipanel.tudominio.com,https://www.aipanel.tudominio.com

# Rate limiting (requests por minuto)
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ==================================
# CONFIGURACIÓN DE AGENTES AI
# ==================================
# Modelo por defecto para nuevos agentes
DEFAULT_AI_MODEL=gpt-5-mini

# Límites por defecto
DEFAULT_TOKEN_LIMIT=10000
DEFAULT_CONTEXT_WINDOW=128000

# ==================================
# CONFIGURACIÓN DE FACTURACIÓN
# ==================================
# Días de gracia antes de suspender por falta de pago
GRACE_PERIOD_DAYS=14

# Días para enviar recordatorios de pago
PAYMENT_REMINDER_DAYS=7,10,13

# Moneda por defecto
DEFAULT_CURRENCY=USD

# ==================================
# CONFIGURACIÓN DE LOGS
# ==================================
LOG_LEVEL=info
LOG_FILE_PATH=/var/log/aipanel

# ==================================
# ADMIN INICIAL
# ==================================
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PASSWORD=change_this_admin_password
ADMIN_NAME=Administrador
