[Unit]
Description=AIPanel Celery Beat Scheduler
After=network.target redis.service
Wants=redis.service

[Service]
Type=simple
User=aipanel
Group=aipanel
WorkingDirectory=/var/www/aipanel/backend

# Virtual environment
Environment="PATH=/var/www/aipanel/backend/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONPATH=/var/www/aipanel/backend"

# Configuración
EnvironmentFile=/var/www/aipanel/backend/.env

# Comando de ejecución (tareas programadas)
ExecStart=/var/www/aipanel/backend/venv/bin/celery \
    -A app.celery beat \
    --loglevel=info \
    --logfile=/var/log/aipanel/celery-beat.log \
    --pidfile=/var/run/aipanel/celery-beat.pid

# Restart
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
