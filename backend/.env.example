# AIPanel Backend Configuration
# Copy this file to .env and fill in the values

# Environment
ENVIRONMENT=development
DEBUG=true
PORT=8000

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://aipanel:aipanel_password@localhost:5432/aipanel
DATABASE_ECHO=false

# Security
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI Providers
OPENAI_API_KEY=sk-your-openai-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# Transbank (Chilean payments)
# Leave empty to use integration (test) mode
TRANSBANK_COMMERCE_CODE=
TRANSBANK_API_KEY=
TRANSBANK_PRODUCTION=false

# Admin User (for initial setup)
ADMIN_EMAIL=admin@aipanel.cl
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=Administrator
